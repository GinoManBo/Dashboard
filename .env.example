# Copie este archivo como .env.local y complete su clave.
#
#   cp .env.example .env.local
#
# Obtenga la clave en https://aistudio.google.com/apikey
#
# ADVERTENCIA: al usar el prefijo VITE_, la clave queda incluida en el bundle
# que se sirve al navegador y es visible para cualquier usuario. Use una clave
# desechable y restrinjala por referrer HTTP en Google Cloud Console. Para
# producción, mueva la llamada a Gemini a un backend.

VITE_GEMINI_API_KEY=
